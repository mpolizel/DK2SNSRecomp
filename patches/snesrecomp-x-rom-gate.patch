     /* Positional validators preserve the historical warning-and-continue
      * behavior for explicit command-line overrides. */
     if (positional) {
-        fprintf(stderr, "[Launcher] Warning: continuing anyway with an "
-                        "unverified ROM\n");
+        /* The host's ROM gate decides what happens next. */
+        fprintf(stderr, "[Launcher] Warning: the ROM given on the command "
+                        "line is not verified\n");
         return 1;
     }
 #ifdef _WIN32
